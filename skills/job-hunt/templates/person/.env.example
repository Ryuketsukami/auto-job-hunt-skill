# Copy to people/<person>/.env in the workspace, which is gitignored, and stays
# gitignored.
#
# This file holds one credential and nothing else. Once it exists it is never
# printed, echoed back in chat, written into a summary, copied into any other
# file, pasted into a URL or command line, or included in an error message.
# If a command would print it, redact it before showing the output.
#
# This variable is only needed for automatic email sending. If the person would
# rather send applications themselves, leave this file absent.
#
# MAIL_APP_PASSWORD is an APP PASSWORD, not an account password. It is a
# revocable, single-purpose credential that only works for mail: it cannot sign
# in as the person, cannot change their password, and can be destroyed in one
# click without touching anything else.
#
#   Gmail:   enable 2-Step Verification, then myaccount.google.com/apppasswords
#   Outlook: Security -> App passwords
#
# Never ask anyone for their real password. If they would rather not connect
# mail at all, leave this file absent, every application is then handed over
# for them to send themselves.

MAIL_ADDRESS=
MAIL_APP_PASSWORD=

# Optional. Defaults below are Gmail's; override for another provider.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
